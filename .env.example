# 续月记 M0 环境变量模板。
# 复制为 .env 后按需修改；不要提交真实密钥。
# 本文件中的任何值都不是生产凭据。

NODE_ENV=development
APP_BASE_URL=http://127.0.0.1:5173
API_PORT=3000
API_HOST=127.0.0.1

# PostgreSQL（本地 Compose 默认值，仅开发使用）
DATABASE_URL=postgres://xuyueji:xuyueji_dev@127.0.0.1:5432/xuyueji

# DeepSeek：M0 不调用模型；密钥必须只存在服务端。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_SAFETY_LEVEL=high

# 支付：未获正式准入前必须是 sandbox/mock。
PAYMENT_MODE=mock
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=

# 演示模式闸门。M1 仍必须保持 true。
DEMO_MODE=true
PAYMENTS_ENABLED=false
# 公开注册开关；本地受控演示可临时设为 true。
PUBLIC_SIGNUP_ENABLED=false
# 会话与登录限流
SESSION_TTL_DAYS=7
COOKIE_SECURE=false
AUTH_SIGNUP_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_MAX=10

# 仅用于 `pnpm user:create` 的本地种子账号；不要提交真实值。
# XYJ_USER_EMAIL=demo@example.com
# XYJ_USER_PASSWORD=change-this-to-a-long-password
# XYJ_USER_NAME=演示用户

# 站点
SITE_ADDRESS=:80
# 本地 Compose 端口；8080 被占用时用 HTTP_PORT=18080 覆盖
HTTP_PORT=8080
HTTPS_PORT=8443
